# Copia a functions/.env (NO subir a git). Firebase Functions v2 carga este archivo al desplegar.
#
# Prod (landing-admin-9452e): usa functions/.env.production.example → .env con sk_live_
# Stage: usa functions/.env.staging.example → .env.staging / .env.landings-stage con sk_test_

# URL pública del admin (success/cancel de Stripe / Mercado Pago)
ADMIN_PUBLIC_URL=https://admin.leftsidedev.site

# Email allowlisted for first-root bootstrap via ensureBootstrapRoot (must match VITE_BOOTSTRAP_ROOT_EMAIL).
# BOOTSTRAP_ROOT_EMAIL=you@example.com

# Opcional: dominio personalizado en enlaces de invitación (Auth → Templates → Customize domain).
# Solo después de verificar DNS en Firebase Console. Si no está listo, omítelo: el enlace usará
# landing-admin-9452e.firebaseapp.com como host (comportamiento normal de Firebase).
# No uses prefijo FIREBASE_ (reservado en .env de Cloud Functions).
# AUTH_LINK_DOMAIN=admin.leftsidedev.site

# --- Stripe (suscripciones) ---
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
# Se obtiene al crear el endpoint de webhook (ver docs/auth-and-billing.md)
STRIPE_WEBHOOK_SECRET=whsec_...
# Products → Prices (recurring monthly). Prefer currency-specific IDs:
STRIPE_PRICE_STARTER_USD=price_...
STRIPE_PRICE_STARTER_MXN=price_...
STRIPE_PRICE_PRO_USD=price_...
STRIPE_PRICE_PRO_MXN=price_...
STRIPE_PRICE_AGENCY_USD=price_...
STRIPE_PRICE_AGENCY_MXN=price_...
# Legacy single-price fallback (used if currency-specific missing):
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_AGENCY=price_...
# Opcional (Enterprise suele ser manual):
# STRIPE_PRICE_ENTERPRISE=price_...

# Bootstrap catalog (test or live depending on the secret key):
#   node scripts/ensure-stripe-catalog.mjs --env .env
#   node scripts/ensure-stripe-catalog.mjs --env .env.production

# --- Mercado Pago (preapproval / suscripciones) ---
# https://www.mercadopago.com.mx/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=TEST-...
# Webhooks → Configure notifications → secret signature (required in prod; F06)
# Canonical name (preferred):
# MERCADOPAGO_WEBHOOK_SECRET=
# Legacy alias also accepted by Functions:
# MERCADOPAGO_ACCESS_WEBHOOK_TOKEN=

# --- AI Assist ---
# AI_LITE_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# AI_LITE_MODEL=llama3.2
# AI_OLLAMA_MODEL=llama3.2
# AI_LITE_FALLBACK_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# GROQ_API_KEY=
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# AI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=

# --- Ollama Cloud (askOllamaCloud callable; root-only) ---
# Prefer Secret Manager in deploy:
#   firebase functions:secrets:set OLLAMA_CLOUD_TOKEN
# For local emulator you may put the token here (never commit real values):
# OLLAMA_CLOUD_TOKEN=

# Ya existentes / otras:
# DEFAULT_TEMPLATE_DEPLOY_HOOK_URL=
# Extra hosts for deploy hooks (comma-separated), beyond api.vercel.com / api.netlify.com / api.cloudflare.com:
# DEPLOY_HOOK_HOST_ALLOWLIST=
# GITHUB_DEPLOY_TOKEN=

# See also: functions/.env.staging.example, functions/.env.production.example,
# and docs/environments-dev-stage-prod.md

# App Check on callables (F12). Default: enforced outside emulator. Set 0 to disable temporarily.
# ENFORCE_APP_CHECK=1
