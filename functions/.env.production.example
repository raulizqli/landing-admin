# Production Functions config for Firebase project landing-admin-9452e.
# Copy to functions/.env before `npm run deploy:functions` against Prod.
# Never commit this file. Keep Stage keys in functions/.env.staging.

ADMIN_PUBLIC_URL=https://admin.leftsidedev.site

# --- Stripe LIVE (Dashboard → Developers → API keys → Live) ---
STRIPE_SECRET_KEY=sk_live_...
# Webhook (Live mode) → endpoint:
#   https://us-central1-landing-admin-9452e.cloudfunctions.net/stripeBillingWebhook
# Events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=whsec_...

# Prefer currency-specific prices (from: node scripts/ensure-stripe-catalog.mjs --env .env.production)
STRIPE_PRICE_STARTER_USD=price_...
STRIPE_PRICE_STARTER_MXN=price_...
STRIPE_PRICE_PRO_USD=price_...
STRIPE_PRICE_PRO_MXN=price_...
STRIPE_PRICE_AGENCY_USD=price_...
STRIPE_PRICE_AGENCY_MXN=price_...
# Legacy fallbacks (used if *_USD / *_MXN missing) — usually same as USD
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_AGENCY=price_...
# STRIPE_PRICE_ENTERPRISE=price_...

# --- Mercado Pago LIVE ---
MERCADOPAGO_ACCESS_TOKEN=APP_USR-...

# --- AI Assist (production quotas) ---
# AI_LITE_PROVIDER=gemini
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=
# AI_MODEL=gpt-4o-mini
