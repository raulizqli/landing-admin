{
  "name": "ecosistema-landings-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "npm run build && firebase deploy --only functions",
    "stripe:catalog": "node scripts/ensure-stripe-catalog.mjs --env .env",
    "stripe:catalog:prod": "node scripts/ensure-stripe-catalog.mjs --env .env.production",
    "stripe:catalog:staging": "node scripts/ensure-stripe-catalog.mjs --env .env.staging"
  },
  "dependencies": {
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^6.6.0",
    "ollama": "^0.5.18",
    "stripe": "^18.5.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
