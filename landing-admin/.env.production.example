# Copia a .env.production antes de `npm run build` (o `npm run deploy:admin` desde la raíz).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# URL pública del template (Firebase Hosting) para vista previa Local en producción
VITE_TEMPLATE_PREVIEW_URL=https://web.toqua.site

# Marketing Toqua (prioridad de `/` y «Volver al sitio»).
VITE_CORPORATE_SITE_URL=https://toqua.site

# Fallback de `/` cuando no hay corporativo.
VITE_MARKETING_URL=https://toqua.site

VITE_FIREBASE_MEASUREMENT_ID=

# demos bloqueados en producción
VITE_APP_ENV=prod

# App Check — reCAPTCHA Enterprise (proyecto landing-admin-9452e)
VITE_RECAPTCHA_SITE_KEY=
VITE_RECAPTCHA_ENTERPRISE=true

# Email del primer root (opcional)
# VITE_BOOTSTRAP_ROOT_EMAIL=

# CTA Enterprise (mailto)
# VITE_BILLING_SALES_EMAIL=sales@tudominio.com

# Meta / Facebook Login (App ID público; secret en functions/.env)
# App Dashboard → Settings → Basic:
#   https://admin.toqua.site/privacy
#   https://admin.toqua.site/terms
#   https://admin.toqua.site/data-deletion
VITE_FACEBOOK_APP_ID=1613320007179076
# VITE_LEGAL_CONTACT_EMAIL=hello@toqua.site

# Google AdSense — free-tier CMS bar + Save & Publish (Display). Use a different slot than landings.
VITE_GOOGLE_ADS_CLIENT=ca-pub-8125831908133216
VITE_GOOGLE_ADS_SLOT=4462279714
