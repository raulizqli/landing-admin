VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Email del primer usuario root (opcional, solo desarrollo/bootstrap inicial)
VITE_BOOTSTRAP_ROOT_EMAIL=

# Dev: emulador de Cloud Functions (ej. 127.0.0.1:5001)
VITE_FUNCTIONS_EMULATOR_HOST=

# App Check — reCAPTCHA Enterprise (score) o v3 clásico.
# Crear en Google Cloud → reCAPTCHA Enterprise, o https://www.google.com/recaptcha/admin/create
# Dominios requeridos: admin.toqua.site, landing-admin-9452e.web.app, localhost, 127.0.0.1
VITE_RECAPTCHA_SITE_KEY=
# true = ReCaptchaEnterpriseProvider (claves creadas con gcloud / Cloud Console). false = v3 clásico.
VITE_RECAPTCHA_ENTERPRISE=true

# Dev: token de depuración de App Check (Firebase Console → App Check → Manage debug tokens)
# Si se omite en dev, la consola del navegador imprimirá un token al cargar la app.
VITE_APP_CHECK_DEBUG_TOKEN=

# URL del template en Firebase Hosting (dev: http://localhost:5174)
# URL del template en prod (host por defecto para abrir landings: ?pageId=…)
VITE_TEMPLATE_PREVIEW_URL=https://web.toqua.site

# Sitio de marketing del producto Toqua (prioridad para «Volver al sitio»).
# Dev tip: http://localhost:5176
# Prod: https://toqua.site
VITE_CORPORATE_SITE_URL=

# Fallback de marketing si CORPORATE está vacío
# Dev tip: http://localhost:5176
# Prod default si se omite: https://toqua.site
VITE_MARKETING_URL=

# Opcional: GA4 por defecto si la landing no define analyticsMeasurementId en Firestore
VITE_FIREBASE_MEASUREMENT_ID=

# Entorno de la app: dev | stage | prod (demos solo en dev/stage)
# VITE_APP_ENV=dev

# Segundos que un usuario free debe ver el anuncio antes de Guardar y Publicar (mín. 5)
# VITE_FREE_TIER_SAVE_AD_SECONDS=10

# Google AdSense — barra free-tier + modal Guardar y Publicar (unidad Display distinta a landings)
# VITE_GOOGLE_ADS_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
# VITE_GOOGLE_ADS_SLOT=

# Email del CTA «Contact sales» del plan Enterprise
VITE_BILLING_SALES_EMAIL=

# Meta / Facebook Login (solo App ID público). El App Secret va en functions/.env
# Crear app en https://developers.facebook.com/ — agregar dominio del admin a Valid OAuth Redirect URIs
# App Dashboard → Settings → Basic (URLs públicas, sin login):
#   Privacy Policy URL:     https://admin.toqua.site/privacy
#   Terms of Service URL:   https://admin.toqua.site/terms
#   User data deletion URL: https://admin.toqua.site/data-deletion
VITE_FACEBOOK_APP_ID=1613320007179076
# VITE_LEGAL_CONTACT_EMAIL=hello@toqua.site

# Dev: Ollama local (default engine en localhost).
# Arranca con CORS para Vite: npm run ollama:serve   (o OLLAMA_ORIGINS=http://localhost:5173 ollama serve)
# Modelo: ollama pull llama3.2
# VITE_OLLAMA_BASE_URL=http://127.0.0.1:11434
# VITE_OLLAMA_MODEL=llama3.2
