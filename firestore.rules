rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userExists() {
      return isSignedIn() && exists(userDocPath());
    }

    function userData() {
      return get(userDocPath()).data;
    }

    function isRoot() {
      return userExists() && userData().role == 'root';
    }

    function isAdmin() {
      return userExists() && userData().role == 'admin';
    }

    function isRegularUser() {
      return userExists() && userData().role == 'user';
    }

    function canEditPage(pageId) {
      // Agency/Pro owners often keep pages in assignedPageIds (not only users.pageId).
      let inAssigned = userData().keys().hasAll(['assignedPageIds'])
        && pageId in userData().assignedPageIds;
      let isPrimaryUserPage = userData().keys().hasAll(['pageId'])
        && userData().pageId == pageId;
      return isRoot()
        || (isAdmin() && inAssigned)
        || (isRegularUser() && (isPrimaryUserPage || inAssigned));
    }

    function isEmptyString(value) {
      return value == null || value == '';
    }

    /**
     * Billing-owned + deploy-secret fields must not be changed by page editors.
     * siteAccess / unpaidSince: only Admin SDK (Cloud Functions).
     * hostingDeployHookUrl + GitHub deploy targets: only clearable on the public doc
     * (migration); real values live under private/hosting (F03).
     */
    function pageUpdateAllowed(pageId) {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      let siteAccessLocked = !affected.hasAny(['siteAccess', 'unpaidSince']);
      let hookOk = !affected.hasAny(['hostingDeployHookUrl'])
        || isEmptyString(request.resource.data.get('hostingDeployHookUrl', ''));
      let githubOk = (
          !affected.hasAny(['hostingGithubOwner'])
          || isEmptyString(request.resource.data.get('hostingGithubOwner', ''))
        )
        && (
          !affected.hasAny(['hostingGithubRepo'])
          || isEmptyString(request.resource.data.get('hostingGithubRepo', ''))
        )
        && (
          !affected.hasAny(['hostingGithubWorkflow'])
          || isEmptyString(request.resource.data.get('hostingGithubWorkflow', ''))
        )
        && (
          !affected.hasAny(['hostingGithubRef'])
          || isEmptyString(request.resource.data.get('hostingGithubRef', ''))
        );
      return canEditPage(pageId) && siteAccessLocked && hookOk && githubOk;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isRoot());
      // Root profiles are created via Admin SDK (ensureBootstrapRoot / createCmsUser), never by client self-bootstrap.
      allow create: if isRoot();
      allow update, delete: if isRoot();
    }

    /**
     * F03 Step B: anonymous get stays (landings), anonymous list is denied (no bulk PII scrape).
     * Staff list: root only. Admins/users load assigned pages via get.
     */
    match /pages/{pageId} {
      allow get: if true;
      allow list: if isRoot();
      allow create: if isRoot();
      allow update: if pageUpdateAllowed(pageId);
      allow delete: if isRoot();

      match /routes/{routeId} {
        allow read: if true;
        allow create, update: if canEditPage(pageId);
        allow delete: if canEditPage(pageId) || isRoot();
      }

      // Deploy hooks and other hub secrets — editors of the page only; never public.
      match /private/{docId} {
        allow read, write: if canEditPage(pageId);
      }
    }

    match /paginas/{pageId} {
      allow get: if true;
      allow list: if isRoot();
      allow create: if isRoot();
      allow update: if pageUpdateAllowed(pageId);
      allow delete: if isRoot();

      match /routes/{routeId} {
        allow read: if true;
        allow create, update: if canEditPage(pageId);
        allow delete: if canEditPage(pageId) || isRoot();
      }

      match /private/{docId} {
        allow read, write: if canEditPage(pageId);
      }
    }

    /**
     * Public hostname → pageId index for custom-domain routing without listing /pages.
     */
    match /domainIndex/{domain} {
      allow get: if true;
      allow list: if isRoot();
      allow create: if isSignedIn()
        && canEditPage(request.resource.data.pageId);
      allow update: if isSignedIn()
        && canEditPage(resource.data.pageId)
        && canEditPage(request.resource.data.pageId);
      allow delete: if isSignedIn() && canEditPage(resource.data.pageId);
    }

    match /billingAccounts/{accountId} {
      allow read: if isSignedIn()
        && (isRoot()
          || resource.data.ownerUid == request.auth.uid
          || (userExists()
            && userData().keys().hasAll(['accountId'])
            && userData().accountId == accountId));
      allow create: if isSignedIn()
        && (isRoot()
          || (request.resource.data.ownerUid == request.auth.uid
            && request.auth.uid == accountId));
      allow update, delete: if isRoot();

      // BYOK API keys and other secrets — Admin SDK / Cloud Functions only (F11).
      match /secrets/{docId} {
        allow read, write: if false;
      }
    }

    /**
     * Page change audits — written only by Cloud Functions (Admin SDK).
     */
    match /pageAudits/{auditId} {
      allow read: if isSignedIn()
        && (isRoot() || canEditPage(resource.data.pageId));
      allow create, update, delete: if false;
    }

    /**
     * In-app notifications — create via CF; recipient can mark read.
     */
    match /notifications/{notificationId} {
      allow read: if isSignedIn()
        && (isRoot() || resource.data.recipientUid == request.auth.uid);
      allow create, delete: if false;
      allow update: if isSignedIn()
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.recipientUid == resource.data.recipientUid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'readAt']);
    }

    /**
     * Internal CMS tickets — root/admin via CF primarily; client read for assigned pages.
     */
    match /tickets/{ticketId} {
      allow read: if isSignedIn()
        && (isRoot()
          || (isAdmin() && canEditPage(resource.data.pageId)));
      allow create, update, delete: if false;
    }

    /**
     * Referral codes — lookup by code for signup flow; owner can read their own.
     */
    match /referralCodes/{code} {
      allow get: if true;
      allow list: if isRoot();
      allow create, update, delete: if false;
    }

    /**
     * Referral clicks — tracking only via Cloud Functions.
     */
    match /referralClicks/{clickId} {
      allow read: if isSignedIn() && isRoot();
      allow create, update, delete: if false;
    }

    /**
     * Referral conversions — referrer can read their own conversions.
     */
    match /referralConversions/{conversionId} {
      allow read: if isSignedIn()
        && (isRoot() || resource.data.referrerId == request.auth.uid);
      allow create, update, delete: if false;
    }
  }
}
