# Copia a .env.production antes de `npm run build` / `npm run deploy:template`.
# Vite inyecta estas variables en el bundle en tiempo de compilación.
# En CI se pasan como GitHub Actions secrets (ver workflows de hosting).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Multi-dominio: suele quedar vacío (customDomain / ?pageId=).
# VITE_PAGINA_ID=

VITE_ADMIN_ORIGIN=https://admin.leftsidedev.site
VITE_ADMIN_PUBLIC_URL=https://admin.leftsidedev.site

# Google AdSense — solo Prod (publicidad en sitios unpaid). Stage/Dev: dejar vacío.
# Publisher ID (AdSense → Cuenta) y ad unit slot (Anuncios → unidad display).
VITE_GOOGLE_ADS_CLIENT=ca-pub-8125831908133216
VITE_GOOGLE_ADS_SLOT=
